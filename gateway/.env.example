# Qingyu Memory Gateway — copy to gateway/.env and fill in the values.
# Every variable is listed here with what it does; nothing here is a secret you
# can leave as-is: the three tokens/keys below must be changed before the
# gateway will start outside APP_ENV=test.

# Display name of the service (FastAPI title, logs).
APP_NAME=Qingyu Memory Gateway

# development | production | test. "test" relaxes the secret checks and skips
# the startup DATABASE_URL requirement.
APP_ENV=development

# Address the gateway listens on. Keep 127.0.0.1 unless you mean to expose it.
HOST=127.0.0.1
# Port the gateway listens on.
PORT=8000

# Bearer token for the write/import/archive APIs. Any non-example value that
# you keep secret; must differ from the two secrets below.
API_TOKEN=
# Read-only token for the evidence APIs. Must differ from API_TOKEN.
EVIDENCE_READ_API_TOKEN=
# Signs evidence cursor tokens. Must differ from both tokens above.
EVIDENCE_CURSOR_SIGNING_KEY=

# Local PostgreSQL credentials (read by docker compose and the application):
# Set POSTGRES_PASSWORD and make sure the password in DATABASE_URL uses the same value.
POSTGRES_PASSWORD=
# Replace <POSTGRES_PASSWORD> below with the same value as above
# (no variable expansion here).
DATABASE_URL=postgresql+psycopg://qingyu:<POSTGRES_PASSWORD>@127.0.0.1:5432/qingyu

# Directory the archive stores its files under (absolute path).
ARCHIVE_ROOT=<repo>/data

# Largest accepted import upload, in bytes (default 512 MiB).
IMPORT_UPLOAD_MAX_BYTES=536870912

# How many days failed staging imports are kept before cleanup deletes them.
STAGING_FAILED_RETENTION_DAYS=7
# How often the staging cleanup pass runs, in seconds.
STAGING_CLEANUP_INTERVAL_SECONDS=300
# Cap on how many failed-stage candidates one cleanup pass handles.
STAGING_CLEANUP_MAX_CANDIDATES=100

# DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
